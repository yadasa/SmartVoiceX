{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [{
    "source": "functions"
  }],
  "hosting": {
    "target": "prod",
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" }
    ]
  }
}
